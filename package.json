{
  "name": "priyan-notes-ai",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "node --env-file-if-exists=.env server.mjs",
    "typecheck": "tsc",
    "agent": "eve dev --host 127.0.0.1 --port 2000 --no-default-extensions",
    "agent:server": "eve dev --no-ui --host 127.0.0.1 --port 2000 --no-default-extensions",
    "test": "node --test tests/*.test.mjs",
    "dataset:validate": "node scripts/validate_dataset.mjs",
    "dataset:export": "node scripts/export_dataset.mjs"
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.137",
    "eve": "^0.80.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
